#!/bin/bash
#BSUB -J uditas_bcl2fastq
#BSUB -q standard
#BSUB -n 16
#BSUB -R "span[hosts=1] rusage[mem=4000]"
#BSUB -W 12:00
#BSUB -o bcl2fastq_uditas.%J.out
#BSUB -e bcl2fastq_uditas.%J.err
#
# BCL -> Undetermined FASTQs for UDiTaS, run 261030_VH00889_534_AAJLG3JM5
# (NextSeq 2000, P1, 1 lane, Y301 I8 I18 Y301).
#
# I2 on this run is 10-nt UMI followed by the 8-nt i5 barcode (reverse
# complemented). uditas reads barcode = I2[:8] and UMI = I2[8:], so after
# conversion this script rotates I2 to barcode(8) + UMI(10).
#
# Submit:  bsub < bcl2fastq_uditas.lsf

set -euo pipefail

# ---- EDIT THESE TWO PATHS for the HPC side of the kellogrp share ----------
RUN=/research/groups/kellogrp/home/common/04_InstrumentData/NovaSeq/261030_VH00889_534_AAJLG3JM5
OUT=/research/groups/kellogrp/home/common/10_ProcessedNGS/261030_UDiTaS
# ---------------------------------------------------------------------------

module load bcl2fastq   # check name with: module avail bcl

mkdir -p "$OUT/bcl2fastq_raw"
cd "$OUT"

# Empty sample sheet -> every read goes to Undetermined
printf '[Header]\n\n[Reads]\n301\n301\n\n[Settings]\n\n[Data]\nSample_ID,Sample_Name,index,index2\n' > empty_SampleSheet.csv

bcl2fastq \
  --runfolder-dir "$RUN" \
  --output-dir "$OUT/bcl2fastq_raw" \
  --sample-sheet "$OUT/empty_SampleSheet.csv" \
  --use-bases-mask Y301,I8,I18,Y301 \
  --create-fastq-for-index-reads \
  --no-lane-splitting \
  --mask-short-adapter-reads 0 \
  --minimum-trimmed-read-length 0 \
  -r 4 -p 16 -w 4

RAW="$OUT/bcl2fastq_raw"
ls -l "$RAW"/Undetermined_S0_*.fastq.gz

GZ=gzip; command -v pigz >/dev/null && GZ="pigz -p 16"

# Rotate I2: seq/qual = positions 11-18 (barcode) + positions 1-10 (UMI)
zcat "$RAW/Undetermined_S0_I2_001.fastq.gz" \
  | awk 'NR%4==2 || NR%4==0 { $0 = substr($0,11,8) substr($0,1,10) } { print }' \
  | $GZ > "$OUT/Undetermined_S0_I2_001.fastq.gz"

for r in R1 R2 I1; do
  ln -sf "$RAW/Undetermined_S0_${r}_001.fastq.gz" "$OUT/Undetermined_S0_${r}_001.fastq.gz"
done
# Original editasmedicine/uditas expects _L001_ names; uditas_opt expects none.
for r in R1 R2 I1 I2; do
  ln -sf "Undetermined_S0_${r}_001.fastq.gz" "$OUT/Undetermined_S0_L001_${r}_001.fastq.gz"
done

# Sanity check: top barcodes in the first 2M reads. Expect
#   I1: TCCGTCTT ATTCCGCT AGGACTCG GCATGATC   I2[1-8]: GCGATCTA TACTCCTT
echo "== I1 top barcodes";  zcat "$OUT/Undetermined_S0_I1_001.fastq.gz" | awk 'NR%4==2' | head -2000000 | sort | uniq -c | sort -rn | head -6
echo "== I2 (rotated) top barcodes"; zcat "$OUT/Undetermined_S0_I2_001.fastq.gz" | awk 'NR%4==2{print substr($0,1,8)}' | head -2000000 | sort | uniq -c | sort -rn | head -6
echo "== read counts"; for r in R1 I2; do printf '%s ' $r; zcat "$OUT/Undetermined_S0_${r}_001.fastq.gz" | awk 'END{print NR/4}'; done
